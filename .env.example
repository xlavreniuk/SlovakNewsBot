# Telegram Bot Credentials
# Get token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Target Channel ID (e.g. @your_channel or -1001234567890)
# Make sure the bot is added as an Administrator with "Post Messages" permission!
TELEGRAM_CHANNEL_ID=@your_channel_username

# Google AI Studio API Key (Free at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Path to custom config file (default: config.yaml)
# CONFIG_FILE=config.yaml
